# Cấu hình cổng chạy Backend CineNow
PORT=3000

# Chuỗi kết nối cơ sở dữ liệu MongoDB
# 1. Nếu dùng MongoDB Atlas (Cloud miễn phí):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cinenow?retryWrites=true&w=majority
#
# 2. Nếu dùng MongoDB cài trên máy cục bộ (Local):
MONGODB_URI=mongodb://127.0.0.1:27017/cinenow

# Khóa bí mật xác thực JWT Token
JWT_SECRET=cinenow_secret_key_2026
